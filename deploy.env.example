# Copy to deploy.env (git-ignored) and adjust. Every value can also be set as an environment variable.

# Name for the CloudFormation stack and Amplify app. Use one per environment, e.g. training-tracker-staging.
STACK_NAME=training-tracker

# Where to deploy. Defaults to your AWS CLI's configured region.
AWS_REGION=us-east-1

# Named profile from ~/.aws/config (optional; SSO profiles work too).
# AWS_PROFILE=my-profile

# Amplify branch name; the site is served at https://<branch>.<app-id>.amplifyapp.com
# AMPLIFY_BRANCH=main

# Override the auto-created artifact bucket (<stack>-artifacts-<account>-<region>).
# ARTIFACT_BUCKET=

# Contact sent to browser push services (Google, Apple, Mozilla) with reminders.
# Optional: defaults to the site's URL. Set it if you want push providers to be able to email you.
# CONTACT_EMAIL=you@example.com

# Allowed browser origins for the API. Defaults to the Amplify app URL.
# Set this when you put the site on a custom domain, e.g. https://train.example.com
# CORS_ORIGINS=
